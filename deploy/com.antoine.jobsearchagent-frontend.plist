<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antoine.jobsearchagent-frontend</string>

    <!-- Serves the already-built frontend/dist/ — building happens once per
         deploy (see deploy.sh / deploy.yml), not on every service start.

         `serve` is a Node script (`#!/usr/bin/env node` shebang) — launchd
         does not source shell rc files, so if Node is managed via nvm on
         the mini rather than a fixed system path (Homebrew etc.), this will
         fail to start with "node: command not found" even though it works
         fine over SSH. If that happens, add an EnvironmentVariables/PATH
         entry below pointing at the real node bin dir, or an
         <string>/full/path/to/node</string> as ProgramArguments[0] ahead
         of `serve`. See deploy/README.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/antoineschmider/job-search-agent/frontend/node_modules/.bin/serve</string>
        <string>-s</string>
        <string>dist</string>
        <string>-l</string>
        <string>4173</string>
        <string>--no-clipboard</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/antoineschmider/job-search-agent/frontend</string>

    <key>UserName</key>
    <string>antoineschmider</string>

    <!-- Start on boot, restart automatically if it ever crashes -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/antoineschmider/job-search-agent/frontend/frontend.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/antoineschmider/job-search-agent/frontend/frontend.err.log</string>
</dict>
</plist>
