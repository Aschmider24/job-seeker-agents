<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antoine.jobsearchagent-frontend</string>

    <!-- Serves the already-built frontend/dist/ — building happens once per
         deploy (see deploy.sh / deploy.yml), not on every service start.

         Node must be installed system-wide (Homebrew), not via nvm — see
         deploy/README.md. Even so, launchd's default PATH is just
         /usr/bin:/bin:/usr/sbin:/sbin, which doesn't include Homebrew's bin
         dir, so `serve`'s `#!/usr/bin/env node` shebang would still fail to
         resolve `node` without the explicit PATH below (covers both Apple
         Silicon and Intel Homebrew prefixes). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/antoineschmider/job-search-agent/frontend/node_modules/.bin/serve</string>
        <string>-s</string>
        <string>dist</string>
        <string>-l</string>
        <string>4173</string>
        <string>--no-clipboard</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/antoineschmider/job-search-agent/frontend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>UserName</key>
    <string>antoineschmider</string>

    <!-- Start on boot, restart automatically if it ever crashes -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/antoineschmider/job-search-agent/frontend/frontend.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/antoineschmider/job-search-agent/frontend/frontend.err.log</string>
</dict>
</plist>
